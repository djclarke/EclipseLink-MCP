# PostgreSQL with the AdventureWorks sample already loaded. The data is loaded while the image is built and
# kept in the image, not in a volume, so a container starts in seconds and every new container starts from
# the same data: `docker compose up -d --force-recreate` resets it.
#
# PostgreSQL 17: the official images from 18 on declare /var/lib/postgresql itself as a volume, which would
# hide the data stored under it.
FROM postgres:17 AS load
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip ruby \
 && rm -rf /var/lib/apt/lists/*
ENV PGDATA=/var/lib/postgresql/adventureworks
COPY --chown=postgres:postgres install.sh overlay.sql /aw/
RUN mkdir -p "$PGDATA" && chown postgres:postgres "$PGDATA"
USER postgres
# The owner account (postgres) has no password and can only connect inside the container. Clients use the
# sample's accounts (mcp_reader, mcp_order_entry; see overlay.sql) over TCP.
RUN initdb --username=postgres --auth-local=trust --auth-host=scram-sha-256 -D "$PGDATA" > /dev/null \
 && pg_ctl -D "$PGDATA" -o "-c listen_addresses=''" -w start > /dev/null \
 && PGHOST=/var/run/postgresql PGUSER=postgres /aw/install.sh \
 && pg_ctl -D "$PGDATA" -m fast -w stop > /dev/null \
 && echo "host all all all scram-sha-256" >> "$PGDATA/pg_hba.conf" \
 && echo "listen_addresses = '*'" >> "$PGDATA/postgresql.conf"

FROM postgres:17
ENV PGDATA=/var/lib/postgresql/adventureworks
COPY --from=load --chown=postgres:postgres /var/lib/postgresql/adventureworks /var/lib/postgresql/adventureworks
