                 version="5.0">
    <package>sales</package>

    <entity class="Customer" access="VIRTUAL">
        <table name="CUSTOMER"/>
        <property name="mcp.description" value="A customer account"/>
        <attributes>
            <id name="id" attribute-type="Long"><column name="ID"/><generated-value strategy="IDENTITY"/></id>
            <basic name="name" attribute-type="String"><column name="NAME"/></basic>
            <basic name="region" attribute-type="String">
                <column name="REGION"/>
