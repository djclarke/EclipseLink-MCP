            <basic name="weightKg" attribute-type="Double"><column name="WEIGHT_KG"/></basic>
            <version name="version" attribute-type="Integer"><column name="VERSION"/></version>
        </attributes>
    </entity>

    <entity class="Order" access="VIRTUAL">
        <table name="ORDERS"/>
        <property name="mcp.description" value="A customer order"/>
        <attributes>
            <id name="id" attribute-type="Long"><column name="ID"/></id>
